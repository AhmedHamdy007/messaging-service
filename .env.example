NODE_ENV=production
PORT=3004
LOG_LEVEL=INFO

DATABASE_URL=postgresql://user:password@postgres:5432/messaging_db
PG_POOL_MAX=20

AUTH_SERVICE_URL=http://auth-service:3001
SHOP_SERVICE_URL=http://shop-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3005
INTERNAL_EVENT_TOKEN=change-this-internal-event-token

JWT_PUBLIC_KEY_PATH=/run/secrets/jwtRS256.key.pub
JWT_ISSUER=salon-platform.auth
JWT_AUDIENCE=salon-platform.api
CORS_ALLOWED_ORIGINS=https://your-web-app.example
REALTIME_SESSION_TTL_SECONDS=60

RABBITMQ_URL=amqp://user:password@rabbitmq:5672
